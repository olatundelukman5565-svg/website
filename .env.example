# --- Firebase project (Firestore database + Authentication only — both work ---
# --- on the free Spark plan, no billing account required) ---
# Found in Firebase Console > Project settings > General
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key

# --- Firebase Admin SDK service account ---
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep the \n escape sequences literal (do not replace with real newlines) when
# pasting the private key into a single-line env var / hosting provider secret.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Local development against the Firebase Emulator Suite ---
# Uncomment these to run `npm run dev` against local emulators instead of a
# real Firebase project (start emulators first with `npm run emulators`).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Cloudinary (image/PDF/file storage) ---
# Free tier, no credit card required. Sign up at https://cloudinary.com/users/register/free
# then copy these three values from your Dashboard's "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Admin account bootstrap (used by `npm run create-admin`) ---
# Avoid a leading "#" or a bare "#" elsewhere in the value — Node's --env-file
# loader treats it as a comment marker and will silently truncate the value.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately
