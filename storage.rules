rules_version = '2';

// All uploads/downloads for this application go through the Next.js server
// using the Firebase Admin SDK, which bypasses these rules entirely.
// Direct client access to Storage is not part of this app's architecture,
// so we deny it by default as defense in depth.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
