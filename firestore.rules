rules_version = '2';

// All reads and writes for this application go through the Next.js server
// using the Firebase Admin SDK, which bypasses these rules entirely.
// Direct client access to Firestore is not part of this app's architecture,
// so we deny it by default as defense in depth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
